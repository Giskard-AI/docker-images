{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":pinAllExceptPeerDependencies",
    "docker:pinDigests"
  ],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "Group GitHub Actions and action version inputs into a single PR. Leave workflow Docker images (services/containers) ungrouped.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "action",
        "uses-with",
        "workflow"
      ],
      "groupName": "{{manager}} dependencies",
      "groupSlug": "{{manager}}-deps",
      "matchUpdateTypes": [
        "*"
      ]
    }
  ]
}
